src/*
!src/leap_finetune/
.hf/
.hf-cache/

# Outputs and logs
outputs/
logs/
job_configs/slurms/

# Scripts
scripts/

# Quick testing files
*.ipynb
scratch/

# Tokenization cache
.cache/

# Test/tool caches
.pytest_cache/
.ruff_cache/
tests/slurm/generated/

# wandb local run dirs (offline logs, large + transient)
wandb/

# Blog/demo generated artifacts only (predictions, downloaded OOD images,
